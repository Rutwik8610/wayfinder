# ===================================================================
# WayFinder Root .gitignore
# ===================================================================

# Dependencies
node_modules/
/.pnpm-store/

# Build and Compilation Outputs
.next/
out/
build/
dist/
target/
bin/

# TypeScript & Framework Caches
*.tsbuildinfo
next-env.d.ts
downloads/

# IDE & Editor Files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/
.apt_generated
.factorypath
.springBeans
.sts4-cache

# OS Files
.DS_Store
Thumbs.db

# Logs
*.log
*.log*
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment Variables & Secrets
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
*.jks
*.keystore
**/key.properties

# Secret / Local properties
**/application-local.properties
**/application-secret.properties

# Quarantined / legacy directories
_review/
