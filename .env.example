# ===================================================================
# WayFinder - Environment Variables Template
# Copy this file to `.env` or set these in your local environment.
# ===================================================================

# --- Backend Configuration (Spring Boot) ---
DB_URL=jdbc:postgresql://localhost:5432/tourism_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# Security: JWT secret must be at least 32 UTF-8 characters long
JWT_SECRET=your_at_least_32_bytes_jwt_secret_key_here
JWT_EXPIRATION_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API key for backend AI assistant and grounded budget calculations
GEMINI_API_KEY=your_gemini_api_key_here

# --- Frontend Configuration (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional client-side API keys (if configured)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
