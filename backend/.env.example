# ===================================================================
# WayFinder Backend (.env) Template
# Copy this to `backend/.env` for local backend development
# ===================================================================

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/tourism_db
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication (Min 32 characters)
JWT_SECRET=your_at_least_32_bytes_jwt_secret_key_here
JWT_EXPIRATION_SECONDS=3600
FRONTEND_ORIGIN=http://localhost:3000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
